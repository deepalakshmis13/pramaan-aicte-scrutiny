# Copy to backend/.env and adjust. Never commit real secrets.
APP_ENV=development
# Required in production: a long random string (e.g. python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://aicte:aicte_dev@localhost:5432/aicte_verify
ACCESS_TOKEN_MINUTES=480
# Set true when served over HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DIR=../storage
MAX_UPLOAD_MB=15
# Crossref: live | simulated | disabled   (simulated results are always labelled and never count as verified)
CROSSREF_MODE=live
CROSSREF_MAILTO=
CROSSREF_TIMEOUT_SECONDS=8
# Scopus indexing checks need an institutional Elsevier key; leave empty to route indexing claims to manual review
SCOPUS_API_KEY=
SCOPUS_INSTTOKEN=
# thread = background worker thread; sync = inline (used by tests and the seed script)
JOBS_MODE=thread
# Optional: path to the tesseract binary if not on PATH
TESSERACT_CMD=
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Optional fixed date for validity checks (YYYY-MM-DD); empty = today
EXPIRY_REFERENCE_DATE=
